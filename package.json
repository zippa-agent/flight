{
  "name": "@tinyfat/flight",
  "version": "0.1.0",
  "description": "Flue-native TinyFat agent orchestrator.",
  "type": "module",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinyfatco/flight.git"
  },
  "scripts": {
    "postinstall": "node scripts/patch-flue-tool-labels.mjs",
    "build": "node scripts/patch-flue-tool-labels.mjs && npm run build:ui && flue build --target cloudflare",
    "build:ui": "vite build --config ui/vite.config.ts && node scripts/build-ui-assets.mjs",
    "deploy": "wrangler deploy --config dist/flight/wrangler.json",
    "dev": "node scripts/patch-flue-tool-labels.mjs && flue dev --target cloudflare",
    "test": "node scripts/patch-flue-tool-labels.mjs && tsx --test test/**/*.test.ts",
    "typecheck": "node scripts/patch-flue-tool-labels.mjs && tsc --noEmit && tsc -p ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flue/runtime": "1.0.0-beta.1",
    "agents": "^0.14.1",
    "hono": "^4.10.7",
    "marked": "^17.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.0",
    "@flue/cli": "1.0.0-beta.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "wrangler": "^4.49.0"
  }
}
